# NODE_ENV=development
# PORT=5000
# ##MONGODB_URI=mongodb://localhost:27017/inventory_billing?replicaSet=rs0&directConnection=true
# MONGODB_URI=mongodb://localhost:27017/inventory-billing?replicaSet=rs0
# JWT_ACCESS_SECRET=mtO+k//VIlbfgilI4ugE/Jm/PSperJXCxO6DK/LiK+j4XevUoK3ZWtoFCpVP+pEQ25s1H+0VAxVDubS6hP2Ixg==
# JWT_REFRESH_SECRET=ujHm9GTfx4z2r6n8hjKg6kxfhmzemjkf1llOxvuUFFA9eYiq0zo1iXi+J8/l09NpVst22LtCBe/4lJaBYrxjiA==
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_ROUNDS=12
# CLIENT_ORIGIN=http://localhost:5173
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ENABLE_CRON=false
# ALERT_FROM_EMAIL=
# # Optional. Lets an external scheduler call POST /api/v1/jobs/low-stock-alerts
# # CRON_SECRET=

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/inventory_billing?replicaSet=rs0&directConnection=true

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Only used when the browser talks to the API directly (cross-origin). Not needed with the Vercel rewrite.
CLIENT_ORIGIN=http://localhost:5173

# 1 = Render alone, 2 = Vercel rewrite in front of Render. Check the logs after deploying (see the guide).
TRUST_PROXY=1

# Alert emails. Leave SMTP_HOST empty to log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=

# true only on an always-on server. On a free tier that sleeps, use the /jobs endpoint instead.
ENABLE_CRON=false
# Lets an external scheduler call POST /api/v1/jobs/low-stock-alerts (x-cron-secret header)
# CRON_SECRET=